---
type IconName = 'calendar' | 'map' | 'instagram' | 'facebook' | 'youtube' | 'whatsapp';
interface Props { name: IconName; }
const { name } = Astro.props;
---

<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
	{name === 'calendar' && <><rect x="3" y="4.5" width="18" height="16" rx="2" /><path d="M7 2.8v3.4M17 2.8v3.4M3 9h18M8 13h.01M12 13h.01M16 13h.01M8 17h.01M12 17h.01" /></>}
	{name === 'map' && <><path d="M20 10.4c0 5.2-8 10.8-8 10.8S4 15.6 4 10.4a8 8 0 1 1 16 0Z" /><circle cx="12" cy="10.4" r="2.7" /></>}
	{name === 'instagram' && <><rect x="3.2" y="3.2" width="17.6" height="17.6" rx="4.6" /><circle cx="12" cy="12" r="4.1" /><circle cx="17.35" cy="6.7" r=".8" fill="currentColor" stroke="none" /></>}
	{name === 'facebook' && <path fill="currentColor" stroke="none" d="M13.8 21v-7.7h2.6l.4-3h-3V8.4c0-.9.3-1.5 1.6-1.5H17V4.2c-.4 0-1.2-.1-2.2-.1-2.3 0-3.8 1.4-3.8 4v2.2H8.4v3H11V21h2.8Z" />}
	{name === 'youtube' && <><path fill="currentColor" stroke="none" d="M21.5 7.1a2.8 2.8 0 0 0-2-2C17.8 4.6 12 4.6 12 4.6s-5.8 0-7.5.5a2.8 2.8 0 0 0-2 2C2 8.8 2 12 2 12s0 3.2.5 4.9a2.8 2.8 0 0 0 2 2c1.7.5 7.5.5 7.5.5s5.8 0 7.5-.5a2.8 2.8 0 0 0 2-2C22 15.2 22 12 22 12s0-3.2-.5-4.9Z" /><path fill="var(--sand)" stroke="none" d="m10 15.3 5.2-3.3L10 8.7v6.6Z" /></>}
	{name === 'whatsapp' && <><path d="M20.3 11.6a8.1 8.1 0 0 1-11.9 7.2L3.5 20l1.3-4.7A8.1 8.1 0 1 1 20.3 11.6Z" /><path d="M8.8 8.2c.2-.5.4-.5.7-.5h.5c.2 0 .4.1.5.4l.8 1.8c.1.3.1.5 0 .7l-.5.6c-.2.2-.1.4.1.6.5.8 1.2 1.4 2 1.8.2.1.4.1.6-.1l.6-.7c.2-.2.4-.2.7-.1l1.7.8c.3.1.4.3.4.5v.5c0 .3-.2.5-.5.7-.4.2-1 .3-1.7.1-1-.3-2.3-1.1-3.5-2.3-1.1-1.1-1.9-2.4-2.2-3.4-.2-.7-.1-1.3.1-1.7Z" /></>}
</svg>
