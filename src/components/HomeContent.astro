---
import EventCard from './EventCard.astro';
import Header from './Header.astro';
import QuickIcon from './QuickIcon.astro';
import { events, site } from '../data/site';
---

<Header />
<main>
	<section class="hero" id="inicio">
		<div class="hero-image" aria-hidden="true"></div><div class="hero-shade" aria-hidden="true"></div>
		<div class="container hero-content"><p class="eyebrow light">ICE Parque San Martín</p><h1>Un lugar para<br /><em>encontrarte.</em></h1><p class="hero-copy">Somos una comunidad que camina junta, con fe, esperanza y espacio para todos.</p><div class="hero-actions"><a class="button coral" href="#agenda">Ver próximos encuentros</a><a class="text-link" href="#nosotros">Conocenos <span>↓</span></a></div></div>
		<div class="hero-note"><span></span> Aristóbulo del Valle 2580 · Merlo</div>
	</section>
	<section class="agenda section" id="agenda"><div class="container"><div class="section-heading"><div><p class="eyebrow">No te lo pierdas</p><h2>Próximos<br />encuentros.</h2></div><a class="button outline" href="/calendario">Ver calendario completo <span>→</span></a></div><div class="event-grid">{events.slice(0, 3).map((event) => <EventCard event={event} />)}</div></div></section>
	<section class="about section" id="nosotros"><div class="container about-grid"><div><h2>La fe se vive<br />mejor <em>en comunidad.</em></h2><p>En ICE Parque queremos que encuentres un espacio genuino para conocer a Dios, hacer amigos y ser parte de algo que transforma tu día a día.</p><a class="text-link dark" href="#contacto">Hablemos <span>→</span></a></div></div></section>
	<section class="schedule section" id="comunidad"><div class="container schedule-grid"><div><p class="eyebrow">Nuestra semana</p><h2>Siempre hay<br />un lugar para vos.</h2></div><div class="schedule-list"><div><b>Domingos</b><span>11:00 hs · Reunión general</span></div><div><b>Miércoles</b><span>20:00 hs · Oración y enseñanza</span></div><div><b>Sábados</b><span>18:00 hs · Jóvenes Fuera de Serie</span></div></div></div></section>
	<section class="ministries section"><div class="container"><p class="eyebrow">Conectá</p><h2>Una comunidad,<br />muchas formas de ser parte.</h2><div class="ministry-grid"><article><span>01</span><h3>Niños</h3><p>Un lugar seguro para crecer y descubrir.</p></article><article><span>02</span><h3>Jóvenes</h3><p>Preguntas honestas, amistades reales.</p></article><article><span>03</span><h3>Familias</h3><p>Caminar acompañados cambia todo.</p></article></div></div></section>
	<section class="location section" id="ubicacion"><div class="container location-card"><div><p class="eyebrow light">Nos encontramos acá</p><h2>Tu lugar<br />también está acá.</h2><p>{site.address}</p><a class="button coral" href={site.links.maps} target="_blank" rel="noreferrer">Cómo llegar <span>↗</span></a></div><div class="map-mark" aria-hidden="true"><QuickIcon name="map" /><p>ICE<br />PARQUE</p></div></div></section>
</main>
<footer id="contacto"><div class="container footer-grid"><div><a class="footer-brand" href="/inicio">ICE<span>PARQUE</span></a><p>.<br />San Martín, Buenos Aires.</p></div><div class="footer-links"><a href="/calendario">Calendario</a><a href={site.links.instagram} target="_blank" rel="noreferrer">Instagram</a><a href={site.links.facebook} target="_blank" rel="noreferrer">Facebook</a><a href={site.links.youtube} target="_blank" rel="noreferrer">YouTube</a><a href={site.links.whatsapp} target="_blank" rel="noreferrer">WhatsApp</a></div><small>© {new Date().getFullYear()} ICE Parque</small></div></footer>

<style>
.hero { color: var(--cream); min-height: min(780px, 100svh); overflow: hidden; position: relative; }.hero-image, .hero-shade { inset: 0; position: absolute; }.hero-image { background: url('/images/hero-community.png') center/cover no-repeat; }.hero-shade { background: linear-gradient(90deg, rgba(23,59,44,.94) 0%, rgba(23,59,44,.68) 40%, rgba(23,59,44,.13) 100%); }.hero-content { padding-top: clamp(10rem, 22vh, 14rem); position: relative; }.eyebrow { color: var(--coral-dark); font-size: .72rem; font-weight: 800; letter-spacing: .13em; margin: 0 0 1rem; text-transform: uppercase; }.eyebrow.light { color: var(--coral-light); }.hero h1, h2 { font-family: var(--font-display); font-weight: 700; letter-spacing: -.065em; line-height: .9; }.hero h1 { font-size: clamp(4rem, 8vw, 7.5rem); margin: 0; }.hero h1 em, h2 em { color: var(--coral); font-style: normal; }.hero-copy { font-size: 1.1rem; line-height: 1.6; margin: 2rem 0; max-width: 28rem; }.hero-actions { align-items: center; display: flex; gap: 1.4rem; }.button { align-items: center; border-radius: 999px; display: inline-flex; font-size: .88rem; font-weight: 700; gap: .7rem; justify-content: center; padding: .85rem 1.15rem; }.button.coral { background: var(--coral); color: var(--navy); }.text-link { border-bottom: 1px solid var(--coral); font-size: .9rem; font-weight: 700; padding-bottom: .25rem; }.text-link span { color: var(--coral); margin-left: .35rem; }.hero-note { bottom: 2.2rem; font-size: .75rem; letter-spacing: .03em; position: absolute; right: max(1.5rem, calc((100% - 1120px)/2)); }.hero-note span { background: var(--coral); border-radius: 50%; display: inline-block; height: .5rem; margin-right: .4rem; width: .5rem; }
.section { padding-block: clamp(5rem, 10vw, 8rem); }.section-heading, .schedule-grid { align-items: end; display: flex; justify-content: space-between; }.section h2 { font-size: clamp(2.8rem, 6vw, 5.4rem); margin: 0; }.button.outline { border: 1px solid var(--ink); color: var(--ink); }.event-grid { display: grid; gap: 1rem; grid-template-columns: repeat(3, 1fr); margin-top: 3rem; }.about { background: var(--navy); color: var(--cream); }.about-grid { display: grid; gap: 5rem; grid-template-columns: 1fr 2fr; }.about h2 { max-width: 55rem; }.about p:not(.eyebrow) { color: rgba(255,255,255,.72); font-size: 1.1rem; line-height: 1.65; margin: 2rem 0; max-width: 34rem; }.text-link.dark { color: var(--cream); }.schedule { background: var(--sand); }.schedule-list { width: min(100%, 37rem); }.schedule-list div { border-top: 1px solid var(--line); display: grid; gap: 1rem; grid-template-columns: 8rem 1fr; padding: 1.2rem 0; }.schedule-list div:last-child { border-bottom: 1px solid var(--line); }.schedule-list b { font-family: var(--font-display); font-size: 1.25rem; }.schedule-list span { color: var(--ink-muted); font-size: .95rem; }.ministries h2 { margin-bottom: 3rem; }.ministry-grid { display: grid; grid-template-columns: repeat(3, 1fr); }.ministry-grid article { border-top: 1px solid var(--line); padding: 1.5rem 1.5rem 1.5rem 0; }.ministry-grid article + article { border-left: 1px solid var(--line); padding-left: 1.5rem; }.ministry-grid span { color: var(--coral-dark); font-size: .75rem; font-weight: 800; }.ministry-grid h3 { font-family: var(--font-display); font-size: 1.8rem; letter-spacing: -.04em; margin: 3rem 0 .5rem; }.ministry-grid p { color: var(--ink-muted); max-width: 14rem; }.location { background: var(--navy); }.location-card { align-items: center; color: var(--cream); display: flex; justify-content: space-between; }.location-card h2 { font-size: clamp(3rem, 6vw, 5.7rem); margin: 0; }.location-card p:not(.eyebrow) { color: rgba(255,255,255,.7); margin: 1.8rem 0; }.map-mark { align-items: center; border: 1px solid rgba(255,255,255,.3); border-radius: 50%; display: flex; height: min(28vw, 20rem); justify-content: center; transform: rotate(-8deg); width: min(28vw, 20rem); }.map-mark span { color: var(--coral); font-size: 3rem; }.map-mark p { color: var(--cream) !important; font-family: var(--font-display); font-size: 1.6rem; font-weight: 800; line-height: .8; margin-left: .5rem !important; }footer { background: var(--ink); color: var(--cream); padding: 4rem 0 1.5rem; }.footer-grid { display: grid; gap: 2rem; grid-template-columns: 2fr 1fr auto; }.footer-brand { font-family: var(--font-display); font-size: 1.5rem; font-weight: 800; letter-spacing: -.08em; }.footer-brand span { color: var(--coral); }.footer-grid p { color: rgba(255,255,255,.57); font-size: .86rem; line-height: 1.5; }.footer-links { display: grid; gap: .5rem; font-size: .86rem; }.footer-grid small { align-self: end; color: rgba(255,255,255,.45); font-size: .7rem; }
.button { border: 1px solid var(--coral); border-radius: 40px; font-size: .78rem; font-weight: 600; letter-spacing: .04em; padding: .8rem 1.2rem; text-transform: uppercase; transition: background .2s, color .2s, border-color .2s; }.button.coral { color: var(--cream); }.button.coral:hover { background: var(--cream); color: var(--coral-dark); }.button.outline { border-color: var(--coral-dark); color: var(--coral-dark); }.button.outline:hover { background: var(--coral-dark); color: var(--cream); }.map-mark :global(svg) { color: var(--coral); height: 3rem; width: 3rem; }
@media (max-width: 720px) { .hero { min-height: 43rem; }.hero-shade { background: linear-gradient(90deg, rgba(23,59,44,.9), rgba(23,59,44,.36)); }.hero-content { padding-top: 9rem; }.hero h1 { font-size: clamp(3.5rem, 15vw, 5.5rem); }.hero-note { bottom: 1.5rem; left: 1.25rem; }.section-heading, .schedule-grid, .location-card { align-items: start; flex-direction: column; gap: 2rem; }.event-grid, .ministry-grid, .about-grid { grid-template-columns: 1fr; }.ministry-grid article + article { border-left: 0; padding-left: 0; }.ministry-grid article { padding-block: 1.5rem; }.ministry-grid h3 { margin-top: 1.5rem; }.map-mark { height: 12rem; width: 12rem; }.footer-grid { grid-template-columns: 1fr; }.footer-grid small { margin-top: 2rem; }.schedule-list { width: 100%; } }
</style>
