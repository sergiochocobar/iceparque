---
import EventCard from './EventCard.astro';
import QuickIcon from './QuickIcon.astro';
import { events, site } from '../data/site';
const serializedEvents = JSON.stringify(events);
const links = [
	{ label: 'Calendario', detail: 'Próximos eventos', icon: 'calendar', href: '/calendario', internal: true },
	{ label: 'Cómo llegar', detail: 'Abrir Google Maps', icon: 'map', href: site.links.maps },
	{ label: 'Facebook', detail: 'Seguinos', icon: 'facebook', href: site.links.facebook },
	{ label: 'YouTube', detail: 'Mirá nuestros videos', icon: 'youtube', href: site.links.youtube },
];
---

<section class="quick-access" aria-labelledby="quick-title">
	<div class="quick-glow"></div>
	<div class="quick-content">
		<a class="quick-brand" href="/" aria-label="ICE Parque">ICE<span>PARQUE</span></a>
		<p class="quick-tagline">{site.tagline}</p>
		<img class="community-profile" src="/images/community-profile.png" alt="Personas de la comunidad de ICE Parque" />
		<div class="next-event" data-next-event>
			<p class="quick-label">Próximo encuentro</p>
			<EventCard event={events[0]} />
		</div>
		<h1 id="quick-title">Todo lo que necesitás, en un lugar.</h1>
		<nav class="quick-links" aria-label="Accesos rápidos">
			{links.map((link) => (
				<a href={link.href} target={link.internal ? undefined : '_blank'} rel={link.internal ? undefined : 'noreferrer'}>
					<span class="quick-icon"><QuickIcon name={link.icon} /></span>
					<span><strong>{link.label}</strong><small>{link.detail}</small></span>
					<span class="arrow" aria-hidden="true">↗</span>
				</a>
			))}
		</nav>
	</div>
</section>

<script define:vars={{ serializedEvents }}>
	const calendarEvents = JSON.parse(serializedEvents);
	const mapIcon = '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:inline-block;width:.9rem;height:.9rem;vertical-align:-.18rem"><path d="M20 10.4c0 5.2-8 10.8-8 10.8S4 15.6 4 10.4a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10.4" r="2.7"/></svg>';
	const dateFormatter = new Intl.DateTimeFormat('es-AR', { weekday: 'long', day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit', hour12: false });
	const card = document.querySelector('[data-next-event]');
	const refreshNextEvent = () => {
		const next = calendarEvents.find((event) => new Date(event.start) > new Date());
		if (!next) { card.hidden = true; return; }
		card.hidden = false;
		card.querySelector('.event-date').textContent = dateFormatter.format(new Date(next.start)).replace(',', ' ·').toUpperCase();
		card.querySelector('h3').textContent = next.title;
		const place = card.querySelector('.event-place');
		place.innerHTML = next.mode === 'online' ? '◌ Online' : `${mapIcon} ${next.location}`;
	};
	refreshNextEvent();
	setInterval(refreshNextEvent, 60_000);
</script>

<style>
	.quick-access { background: radial-gradient(circle at 7% 95%, rgba(187, 204, 79, .9) 0%, rgba(187, 204, 79, 0) 43%), radial-gradient(circle at 47% 57%, rgba(118, 159, 105, .72) 0%, rgba(118, 159, 105, 0) 48%), linear-gradient(128deg, #799a70 0%, #4f8b79 45%, #287a79 100%); color: var(--cream); min-height: 100svh; overflow: hidden; padding: 2.75rem 1.25rem 3.5rem; position: relative; }
	.quick-glow { background: var(--coral); border-radius: 50%; filter: blur(2px); height: 20rem; opacity: .1; position: absolute; right: -9rem; top: -8rem; width: 20rem; }
	.quick-content { margin: auto; max-width: 34rem; position: relative; text-align: center; }
	.quick-brand { display: inline-block; font-family: var(--font-display); font-size: 1.6rem; font-weight: 800; letter-spacing: -.08em; margin-top: .5rem; }.quick-brand span { color: var(--cream); margin-left: .13em; }
	.quick-tagline { color: rgba(255,255,255,.75); font-size: .9rem; margin: .2rem 0 1.35rem; }.community-profile { border: 4px solid rgba(255,255,255,.83); border-radius: 50%; box-shadow: 0 12px 26px rgba(5,25,16,.24); display: block; height: 7.25rem; margin: 0 auto 2.4rem; object-fit: cover; width: 7.25rem; }
	.quick-label { color: var(--coral-light); font-size: .72rem; font-weight: 800; letter-spacing: .12em; margin-bottom: .6rem; text-transform: uppercase; }
	.next-event :global(.event-card) { background: rgba(255,255,255,.97); }
	h1 { font-family: var(--font-display); font-size: clamp(1.7rem, 6vw, 2.25rem); letter-spacing: -.055em; line-height: 1; margin: 2.8rem 0 1.25rem; }
	.quick-links { display: grid; gap: .7rem; text-align: left; }.quick-links a { align-items: center; background: rgba(255,255,255,.97); border: 1px solid rgba(255,255,255,.9); border-radius: .9rem; color: var(--ink); display: flex; gap: .85rem; min-height: 4.55rem; padding: .6rem .8rem; transition: box-shadow .2s, transform .2s; }.quick-links a:hover { box-shadow: 0 10px 24px rgba(5,25,16,.2); transform: translateY(-2px); }
	.quick-icon { align-items: center; background: var(--sand); border-radius: .65rem; color: var(--coral-dark); display: flex; height: 2.65rem; justify-content: center; width: 2.65rem; }.quick-icon :global(svg) { height: 1.35rem; width: 1.35rem; }
	.quick-links strong, .quick-links small { display: block; }.quick-links strong { font-size: .94rem; }.quick-links small { color: var(--ink-muted); font-size: .74rem; margin-top: .15rem; }.arrow { color: var(--coral-dark); font-size: 1.15rem; margin-left: auto; }
</style>
